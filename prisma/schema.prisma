generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum MediaRefType {
  SERVICE
  DOCTOR
  BLOG
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  VERIFY_EMAIL
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Clinic {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  address      String?
  description  String?
  googleMapUrl String?  @map("google_map_url")
  workingTime  String?  @map("working_time")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  services     Service[]
  doctors      Doctor[]
  appointments Appointment[]

  @@map("clinics")
}

model Service {
  id               Int      @id @default(autoincrement())
  clinicId         Int      @map("clinic_id")
  name             String
  slug             String   @unique
  shortDescription String?  @map("short_description")
  content          String?
  priceFrom        Int?     @map("price_from")
  thumbnailUrl     String?  @map("thumbnail_url")
  isActive         Boolean  @default(true) @map("is_active")
  orderIndex       Int      @default(0) @map("order_index")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  doctors      Doctor[]      @relation("DoctorServices")
  appointments Appointment[]

  @@map("services")
}

model Doctor {
  id              Int      @id @default(autoincrement())
  clinicId        Int      @map("clinic_id")
  name            String
  title           String?
  experienceYears Int?     @map("experience_years")
  description     String?
  avatarUrl       String?  @map("avatar_url")
  isActive        Boolean  @default(true) @map("is_active")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  services     Service[]     @relation("DoctorServices")
  appointments Appointment[]

  @@map("doctors")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  clinicId        Int               @map("clinic_id")
  serviceId       Int?              @map("service_id")
  doctorId        Int?              @map("doctor_id")
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  customerEmail   String?           @map("customer_email")
  appointmentDate DateTime          @map("appointment_date")
  note            String?
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  doctor  Doctor?  @relation(fields: [doctorId], references: [id])

  @@map("appointments")
}

model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  blogs Blog[]

  @@map("blog_categories")
}

model Blog {
  id           Int       @id @default(autoincrement())
  categoryId   Int       @map("category_id")
  title        String
  slug         String    @unique
  thumbnailUrl String?   @map("thumbnail_url")
  excerpt      String?
  content      String?
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category BlogCategory @relation(fields: [categoryId], references: [id])

  @@map("blogs")
}

model Media {
  id        Int          @id @default(autoincrement())
  fileUrl   String       @map("file_url")
  fileType  String       @map("file_type")
  refType   MediaRefType @map("ref_type")
  refId     Int          @map("ref_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("media")
}

model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  otpHash    String
  purpose    OtpPurpose // REGISTER | RESET_PASSWORD | VERIFY_EMAIL
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}
